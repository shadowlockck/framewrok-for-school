{
  "name": "@school-framework/ui",
  "version": "0.1.0",
  "description": "Перевикористовуваний UI-kit та SDK для офіційних сайтів шкіл України (React, Tailwind CSS, Lucide)",
  "type": "module",
  "main": "./dist/lib/school-framework-ui.umd.cjs",
  "module": "./dist/lib/school-framework-ui.js",
  "types": "./dist/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/school-framework-ui.js",
      "require": "./dist/lib/school-framework-ui.umd.cjs"
    },
    "./style.css": "./dist/lib/style.css"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app && npm run build:lib",
    "build:app": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
