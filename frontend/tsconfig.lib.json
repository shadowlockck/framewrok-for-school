{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/lib/types",
    "types": ["vite/client"]
  },
  "include": [
    "src/index.ts",
    "src/context/**/*",
    "src/components/**/*",
    "src/pages/**/*",
    "src/api/**/*"
  ]
}
