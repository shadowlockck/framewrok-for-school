# Copy to .env.prod for the optional Docker Compose production example.
# Replace every empty value before starting the stack.
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
DB_NAME=school_db
DB_USER=school_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Trust this only if your reverse proxy replaces the incoming header.
TRUST_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=True

# Increase after confirming HTTPS works for the whole site.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
BACKEND_HOST_PORT=8000
